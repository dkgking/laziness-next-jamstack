{
  "name": "laziness-next-jamstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "bun run i18n:extract && next build",
    "preview": "bunx sirv-cli@3.0.1 out --port 3000",
    "routes": "bun scripts/locale-routes.ts",
    "typecheck": "content-collections build && next typegen && tsc --noEmit",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && lingui compile --strict",
    "validate:cms": "bun validate.js",
    "deploy:cloudflare": "bun run build && bunx wrangler@4.151.3 deploy",
    "test": "bun test src",
    "verify": "bun run typecheck && bun run check && bun run i18n:check && bun run validate:cms && bun test src && bun run build"
  },
  "dependencies": {
    "@content-collections/core": "^0.15.3",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/next": "^0.2.11",
    "@lingui/core": "^6.10.0",
    "@lingui/format-json": "^6.10.0",
    "@lingui/message-utils": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@content-collections/cli": "^0.1.9",
    "@lingui/cli": "^6.10.0",
    "@types/bun": "1.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "rehype-sanitize": "^6.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
